# Copy to .env and fill in. Never commit .env.
APP_ENV=demo

# PAPER | DEMO | LIVE — required, never inferred (README §6).
EXECUTION_MODE=PAPER

TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_BOT_TOKEN=

TELEGRAM_ADMIN_USER_ID=

# Required when EXECUTION_MODE is DEMO or LIVE.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

DATABASE_URL=sqlite:///data/plough_backer.db

# 1..6 (README §15)
DEFAULT_RISK_MODE=1

# GLOBAL | PER_SOURCE (README §23, recommended PER_SOURCE)
PROGRESSION_SCOPE=PER_SOURCE

EQUITY_LOCK_ENABLED=false
EQUITY_LOCK_VALUE=

REPORT_TIMEZONE=UTC

LOG_LEVEL=INFO

# --- Decisions the README leaves open. The runtime will not start until these are set. ---
# Q-05: lot above broker max -> CAP | REJECT
VOLUME_MAX_POLICY=
# Q-06: risk price for market orders -> LIVE_PRICE | SIGNAL_ENTRY_OR_LIVE
RISK_ENTRY_SOURCE=
# Q-03: |net P/L| at or below this is BREAKEVEN (account currency)
BREAKEVEN_TOLERANCE=
# Q-03: true -> closes not by SL/TP/stop-out are OTHER (+review)
MANUAL_CLOSE_IS_OTHER=
# MT5 order settings (DEMO/LIVE)
MT5_DEVIATION_POINTS=
MT5_MAGIC=
MT5_TERMINAL_PATH=
# Multi-account masters use the prefix declared in config/accounts.yaml:
# MT5_METHOD1_PRIMARY_LOGIN=
# MT5_METHOD1_PRIMARY_PASSWORD=
# MT5_METHOD1_PRIMARY_SERVER=
TELEGRAM_SESSION_PATH=data/telegram
RECONCILE_INTERVAL_SECONDS=30

# Telegram /accounts issues one-time links using this public HTTPS address.
# Put the local form server behind Caddy/nginx, or provide ACCOUNT_SETUP_TLS_CERT/KEY.
ACCOUNT_SETUP_BASE_URL=http://127.0.0.1:8765
ACCOUNT_SETUP_HOST=127.0.0.1
ACCOUNT_SETUP_PORT=8765
ACCOUNT_SETUP_TLS_CERT=
ACCOUNT_SETUP_TLS_KEY=
